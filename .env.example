# Безопасная локальная fake-only конфигурация. Secret values отсутствуют.
# Передавайте файл явно: node --env-file=.env.example <script>.
LCT_BIND_HOST=127.0.0.1
LCT_WEB_HOST=127.0.0.1
LCT_PORT=7456
PORT=3000
LCT_DATA_DIR=.lct

LCT_FAKE_SEMANTIC_PORT=8787
LCT_SEMANTIC_BASE_URL=http://127.0.0.1:8787/v1
LCT_SEMANTIC_MODEL=Qwen/Qwen3.8-27B
LCT_SEMANTIC_ENABLE_THINKING=false
LCT_SEMANTIC_REQUEST_TIMEOUT_MS=300000
LCT_SEMANTIC_READINESS_TIMEOUT_MS=30000
LCT_PPTX_BACKEND=office-kit

# Не помещайте live credentials сюда. Используйте локальный secret store.

