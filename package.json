{
  "name": "lct",
  "version": "0.23.1",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "description": "Presentation compiler for the LCT/VK Tech case: understand arbitrary PPTX templates, generate constrained decks, audit them, and export editable presentations.",
  "license": "Apache-2.0",
  "bin": {
    "od": "./apps/daemon/bin/od.mjs"
  },
  "scripts": {
    "postinstall": "node ./scripts/postinstall.mjs",
    "bootstrap": "node ./scripts/postinstall.mjs",
    "dev": "pnpm exec tools-dev run web",
    "tools-dev": "pnpm exec tools-dev",
    "tools-serve": "pnpm exec tools-serve",
    "lint:craft": "tsx ./scripts/lint-craft-references.ts",
    "typecheck": "pnpm -r --workspace-concurrency=4 --if-present run typecheck"
  },
  "devDependencies": {
    "@lct/components": "workspace:*",
    "@lct/daemon": "workspace:*",
    "@lct/tools-dev": "workspace:*",
    "@lct/tools-serve": "workspace:*",
    "@types/node": "20.19.39",
    "tsx": "4.22.3",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": "~24",
    "pnpm": ">=10.33.2 <11"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.9",
      "devalue": "5.8.1",
      "fast-uri": "3.1.5",
      "hono": "4.12.34",
      "ip-address": "10.3.1",
      "postcss": "8.5.15",
      "protobufjs": "8.4.0",
      "qs": "6.15.2",
      "tar": "7.5.22",
      "tmp": "0.2.7",
      "undici@^6": "6.28.0",
      "undici@^7": "7.29.0",
      "yaml": "2.9.0"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "core-js",
      "esbuild",
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ]
  }
}
