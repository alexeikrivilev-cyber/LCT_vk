{
  "name": "lct",
  "version": "0.23.1",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "description": "Presentation compiler for the LCT/VK Tech case: understand arbitrary PPTX templates, generate constrained decks, audit them, and export editable presentations.",
  "license": "Apache-2.0",
  "bin": {
    "lct": "./apps/daemon/bin/lct.mjs"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @lct/web --filter @lct/daemon run dev",
    "dev:web": "pnpm --filter @lct/web run dev",
    "dev:daemon": "pnpm --filter @lct/daemon run dev",
    "build": "pnpm --filter @lct/web run build && pnpm --filter @lct/daemon run build",
    "start": "pnpm --filter @lct/daemon run start",
    "lint:craft": "tsx ./scripts/lint-craft-references.ts",
    "check:boundary": "node ./scripts/check-presentation-boundary.mjs",
    "test": "node --import tsx --test",
    "typecheck": "pnpm -r --filter @lct/web --filter @lct/daemon run typecheck"
  },
  "devDependencies": {
    "@types/node": "20.19.39",
    "tsx": "4.22.3",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": "~24",
    "pnpm": ">=10.33.2 <11"
  }
}
