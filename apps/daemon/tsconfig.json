{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "src/cli.ts",
    "src/daemon-startup.ts",
    "src/server.ts",
    "src/presentation-store.ts",
    "src/presentation-files.ts",
    "src/presentation-catalog.ts",
    "src/media/**/*.ts",
    "src/presentation/**/*.ts"
  ],
  "exclude": ["dist"]
}
